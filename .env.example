# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENV EXAMPLE)
# TUYỆT ĐỐI KHÔNG ĐIỀN THÔNG TIN THẬT VÀO FILE NÀY
# Copy file này thành .env trên máy local và điền giá trị tương ứng

ENV=development

# Google Service Account Credentials Path (Nếu chạy Production)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# MoMatrix / Outbound Corporate Proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.mservice.com.vn,.mservice.io
